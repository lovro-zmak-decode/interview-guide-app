# Anthropic (Claude) — required if you want it selectable in the UI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (ChatGPT) — required if you want it selectable in the UI
# Default provider is OpenAI (configured in code)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Required: the app refuses to start without these two.
# Key that signs login sessions. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=
# Local SQLite file (a relative path is from the project folder) or, in production, the
# PostgreSQL URL from your host.
DATABASE_URL=sqlite:///data/app.db

# Where uploaded CV/LinkedIn files are kept. "database" is the only backend for now.
# FILE_STORAGE=database

# Web scraping
MAX_LINKS_TO_FOLLOW=6
LINK_FETCH_TIMEOUT_SECONDS=8

# Google OAuth (optional: for Google sign-in)
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5001/auth/google/callback
