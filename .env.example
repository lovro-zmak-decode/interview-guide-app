# Anthropic (Claude) — required if you want it selectable in the UI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (ChatGPT) — required if you want it selectable in the UI
# Default provider is OpenAI (configured in code)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Web scraping
MAX_LINKS_TO_FOLLOW=6
LINK_FETCH_TIMEOUT_SECONDS=8

# Google OAuth (optional: for Google sign-in)
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5001/auth/google/callback
