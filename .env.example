# Which provider to use by default: "claude" or "openai"
LLM_PROVIDER=claude

# Anthropic (Claude) — required if LLM_PROVIDER=claude or you want it selectable in the UI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (ChatGPT) — required if LLM_PROVIDER=openai or you want it selectable in the UI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Flask
FLASK_SECRET_KEY=change-me
FLASK_DEBUG=true
# Port the app listens on. Default is 5001 (not 5000) because on macOS,
# "AirPlay Receiver" occupies port 5000 by default and returns a confusing
# HTTP 403 page if something else tries to use it.
FLASK_RUN_PORT=5001

# How many external links (from CV/LinkedIn) to follow and fetch, one level deep
MAX_LINKS_TO_FOLLOW=6
LINK_FETCH_TIMEOUT_SECONDS=8
